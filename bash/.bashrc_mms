set autolist
set filesc
export EDITOR=vim
export VISUAL=vim

alias grep='grep --color=auto'
alias clear_vim='rm -f ~/.vim/tmp/*'
alias docker_rm='docker rm $(docker ps -a -q)'

alias push_tmp_github='. ~/.zsh_mms/push_tmp_github.sh'
alias search_git_changes='. ~/.zsh_mms/search_git_changes.sh'
alias cat='bat'
alias wtf_git=‘git reset --hard && git clean -xdf’
